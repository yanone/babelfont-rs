features = (
{
code = "script latn;

	language TRK exclude_dflt;
		lookup IDOT {
			sub i by idotaccent;
		} IDOT;

	language AZE exclude_dflt;
		lookup IDOT;

	language CRT exclude_dflt;
		lookup IDOT;

	language ROM exclude_dflt;
		lookup SCEDILLA {
			sub scedilla by scommaaccent;
			sub Scedilla by Scommaaccent;
			sub Tcedilla by Tcommaaccent;
			sub tcedilla by tcommaaccent;
		} SCEDILLA;
";
tag = locl;
},
{
code = "    feature ss01;
    feature ss02;
    feature case;
    feature dnom;
    feature numr;
    feature zero;
    ";
tag = aalt;
},
{
code = "    sub [a aacute abreve acircumflex adieresis agrave amacron aogonek aring atilde] by [a.school aacute.school abreve.school acircumflex.school adieresis.school agrave.school amacron.school aogonek.school aring.school atilde.school];
    ";
labels = (
{
language = dflt;
value = ss01;
},
);
tag = ss01;
},
{
code = "    sub [g gbreve gcircumflex gcommaaccent gdotaccent] by [g.alt gbreve.alt gcircumflex.alt gcommaaccent.alt gdotaccent.alt];
    ";
labels = (
{
language = dflt;
value = ss02;
},
);
tag = ss02;
},
{
automatic = 1;
code = "sub exclamdown by exclamdown.case;
sub questiondown by questiondown.case;
sub periodcentered by periodcentered.case;
sub periodcentered.loclCAT by periodcentered.loclCAT.case;
sub hyphen by hyphen.case;
sub endash by endash.case;
sub emdash by emdash.case;
sub horizontalbar by horizontalbar.case;
sub at by at.case;
";
tag = case;
},
{
code = "    sub one slash two by onehalf;
    sub one slash four by onequarter;
    sub three slash four by threequarters;
    ";
tag = frac;
},
{
code = "    sub @fig by @dnom;
    ";
tag = dnom;
},
{
code = "    sub @fig by @dnom;
    ";
tag = subs;
},
{
code = "    sub @fig by @sups;
    ";
tag = numr;
},
{
code = "    sub @fig by @sups;
    ";
tag = sups;
},
{
code = "    sub zero by zero.slash;
    ";
tag = zero;
},
{
code = "    lookup calt1 {
    sub [hyphen endash emdash horizontalbar]' [less greater hyphen endash emdash horizontalbar] by [hyphen.case endash.case emdash.case horizontalbar.case];
    sub [less greater hyphen endash emdash horizontalbar] [hyphen endash emdash horizontalbar]' by [hyphen.case endash.case emdash.case horizontalbar.case];
    } calt1;
    lookup calt2 {
    sub [hyphen.case endash.case emdash.case horizontalbar.case] [hyphen endash emdash horizontalbar]' by [hyphen.case endash.case emdash.case horizontalbar.case];
    sub [hyphen endash emdash horizontalbar]' [hyphen.case endash.case emdash.case horizontalbar.case] by [hyphen.case endash.case emdash.case horizontalbar.case];
    } calt2;
    
";
tag = calt;
},
{
automatic = 1;
code = "lookup ccmp_DFLT_1 {
	@CombiningTopAccents = [acutecomb brevecomb caroncomb circumflexcomb commaturnedabovecomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	lookupflag UseMarkFilteringSet @CombiningTopAccents;
	sub i' @CombiningTopAccents by idotless;
	sub j' @CombiningTopAccents by jdotless;
} ccmp_DFLT_1;
";
tag = ccmp;
},
{
automatic = 1;
code = "sub zero by zeroinferior;
sub one by oneinferior;
